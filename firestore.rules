rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Check if user is the owner of a client
    function isClientOwner(clientId) {
      return isAuth() && 
             get(/databases/$(database)/documents/clients/$(clientId)).data.ownerUid == request.auth.uid;
    }

    // Check if user is a member (Owner OR Supervisor)
    function isClientMember(clientId) {
      let data = getClientData(clientId);
      return isAuth() && 
             (data.ownerUid == request.auth.uid ||
              request.auth.uid in data.supervisorUids);
    }
    
    // Check if user is the owner of a worker's client
    function isWorkerOwner(clientId) {
      return isAuth() && 
             get(/databases/$(database)/documents/clients/$(clientId)).data.ownerUid == request.auth.uid;
    }
    
    // Get client data document
    function getClientData(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId)).data;
    }
    
    // Check if subscription is active
    function isSubActive(clientId) {
      let status = getClientData(clientId).subscriptionStatus;
      return status == 'active';
    }
    
    // Check if trial is active (trial status AND not expired)
    function isTrialActive(clientId) {
      let data = getClientData(clientId);
      return data.subscriptionStatus == 'trial' && request.time < data.trialEndsAt;
    }
    
    // Check if subscription is valid (active OR trial still active)
    function isSubscriptionValid(clientId) {
      return isSubActive(clientId) || isTrialActive(clientId);
    }
    
    // ========================================
    // CLIENTS COLLECTION
    // ========================================
    // Users can only read/write their own client document
    // Document ID = clientId, stores ownerUid, clientName, subscriptionStatus, etc.
    
    match /clients/{clientId} {
      // Read: Owner or supervisors (client members) can read their client data
      allow read: if isClientMember(clientId);
      
      // Write (Create/Update): 
      // - Create: Only authenticated users can create (ownerUid must match)
      // - Update: Only owner can update their data
      allow create: if isAuth() && 
                       request.resource.data.ownerUid == request.auth.uid;
      
      allow update: if isClientOwner(clientId) && 
                       (request.resource.data.ownerUid == resource.data.ownerUid);  // Owner UID cannot change
      
      // Delete: Not allowed (prevent accidental deletion)
      allow delete: if false;
      
      // ========================================
      // SUBCOLLECTIONS (Workers, ProductionEntries, etc.)
      // ========================================
      // All subcollections can only be accessed by the client owner
      
      match /{subcollection=**} {
        allow read, write: if isClientMember(clientId) && isSubscriptionValid(clientId);
      }
    }
    
    // ========================================
    // AUDIT LOG COLLECTION (Shared across clients)
    // ========================================
    // Users can only read audit logs for their own client
    // Audit entries should be written from backend (Cloud Functions)
    
    match /auditLog/{auditId} {
      allow read: if isAuth() && 
                     isClientMember(resource.data.clientId) &&
                     isSubscriptionValid(resource.data.clientId);
      
      // Backend only (via Cloud Functions with admin SDK)
      allow write: if false;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
