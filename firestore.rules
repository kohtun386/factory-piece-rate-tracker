// --- firestore.rules (FINAL v3 - THE COMPLETE FIX) ---

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS (Your original functions)
    // ========================================
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isClientOwner(clientId) {
      return isAuth() && 
             get(/databases/$(database)/documents/clients/$(clientId)).data.ownerUid == request.auth.uid;
    }

    function isClientMember(clientId) {
      let data = getClientData(clientId);
      return isAuth() && 
             (data.ownerUid == request.auth.uid ||
              request.auth.uid in data.supervisorUids);
    }
    
    function isWorkerOwner(clientId) {
      return isAuth() && 
             get(/databases/$(database)/documents/clients/$(clientId)).data.ownerUid == request.auth.uid;
    }
    
    function getClientData(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId)).data;
    }
    
    function isSubActive(clientId) {
      let status = getClientData(clientId).subscriptionStatus;
      return status == 'active';
    }
    
    function isTrialActive(clientId) {
      let data = getClientData(clientId);
      return data.subscriptionStatus == 'trial' && request.time < data.trialEndsAt;
    }
    
    function isSubscriptionValid(clientId) {
      return isSubActive(clientId) || isTrialActive(clientId);
    }
    
    // ========================================
    // CLIENTS COLLECTION (FIXED)
    // ========================================
    match /clients/{clientId} {
      
      // --- 🚨 NEW FIX (THE LOGIN FIX) ---
      // Allow authenticated users to LIST (query/search) the collection.
      // This is required for AuthContext.tsx to find the user's client.
      allow list: if isAuth();

      // Read: Owner or supervisors (client members) can read their OWN client data
      allow read: if isClientMember(clientId);
      
      // Create: Only authenticated users can create (ownerUid must match)
      allow create: if isAuth() && 
                      request.resource.data.ownerUid == request.auth.uid;
      
      // Update: Only owner can update their data
      allow update: if isClientOwner(clientId) && 
                      (request.resource.data.ownerUid == resource.data.ownerUid);
      
      allow delete: if false;
      
      // Subcollections: Only valid members can access
      match /{subcollection=**} {
        allow read, write: if isClientMember(clientId) && isSubscriptionValid(clientId);
      }
    }
    
    // ========================================
    // AUDIT LOG COLLECTION (Your original rules)
    // ========================================
    match /auditLog/{auditId} {
      allow read: if isAuth() && 
                    isClientMember(resource.data.clientId) &&
                    isSubscriptionValid(resource.data.clientId);
      
      allow write: if false; // Backend only
    }

    // ========================================
    // MAIL COLLECTION (Our fix from earlier)
    // ========================================
    match /mail/{docId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }
    
    // ========================================
    // DENY ALL OTHER ACCESS (Your original rule)
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}